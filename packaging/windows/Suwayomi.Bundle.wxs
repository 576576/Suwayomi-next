<?xml version="1.0" encoding="utf-8"?>
<!-- Suwayomi 的 Windows 安装器（Burn bundle）：把上一步的 msi 包在里面。
     BA 用 WixInternalUIBootstrapperApplication —— 它自身没有界面，直接把链里那个 msi 的向导
     当成整个安装流程（首屏即 msi 的欢迎页）。它要求链里只能有一个非永久包、且必须是带完整
     安装/维护界面的 MsiPackage。
     构建命令见 build.yml。产物不能叫 setup.exe：WiX 会以 WIX0388 拒绝（Windows 会为这个名字
     加载兼容性 shim，可被 DLL 劫持），所以产物名是 Suwayomi-<版本>-<目标>-setup.exe。 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!-- IconSourceFile 嵌进 exe 的图标资源：不写的话资源管理器与任务栏显示的是 Burn 自带的默认图标。 -->
  <Bundle Name="Suwayomi" Version="$(Version)" Manufacturer="Suwayomi" Id="Suwayomi.Next.Bundle"
          IconSourceFile="$(IconFile)">
    <BootstrapperApplication>
      <bal:WixInternalUIBootstrapperApplication />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(MsiPath)" />
    </Chain>
  </Bundle>
</Wix>
