*.rs text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.graphql text eol=lf
*.sh text eol=lf
# Gradle wrapper（无扩展名的 sh 脚本）：CRLF 会让 Linux runner 上的 shebang 失效
gradlew text eol=lf
*.yml text eol=lf
*.py text eol=lf
# Windows batch scripts: CRLF required for reliable cmd label/goto handling
*.bat text eol=crlf
